# Copy to credentials.local.yaml and fill in. That file is gitignored.
# GitHub Actions should use secrets YC_EMAIL / YC_PASSWORD instead.

email: "you@example.com"
password: "your-password"

# Wellfound (optional). Actions uses WELLFOUND_EMAIL / WELLFOUND_PASSWORD.
wellfound_email: "you@example.com"
wellfound_password: "your-wellfound-password"
