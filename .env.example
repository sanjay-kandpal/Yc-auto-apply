# Copy to .env for local runs. Never commit the real file.
# GitHub Actions uses repo secrets with the same names.

# Base64-encoded Playwright cookie JSON from scripts/export_session.py
YC_SESSION_COOKIES=

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Groq or Gemini key (must match draft.provider in config.yaml)
LLM_API_KEY=

# Same secret the Cloudflare Worker uses to verify approve/reject links
APPROVAL_HMAC_SECRET=

# Set false in Actions only when you are ready for real submissions
SUBMIT_DRY_RUN=true
